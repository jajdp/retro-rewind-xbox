<?xml version="1.0" encoding="utf-8"?>
<!--
  Identidad PROPIA, distinta de la del Mario Kart Wii (WiiCompiled-MarioKartWii): asi los dos
  paquetes conviven en la consola y cada uno tiene su LocalState, igual que en el PC conviven
  WiiCompiled.exe y RetroRewind.exe dentro de la misma instalacion.

  El Publisher tiene que seguir siendo CN=Decompilaciones: el certificado con el que se firma es
  ese, y el hash de la familia del paquete sale del Publisher como cadena.

  El Executable se llama WiiCompiled.exe porque empaquetar_uwp.py copia el binario con ese nombre
  dentro del paquete, venga del perfil que venga.
-->
<!-- retro-rewind-xbox (Recompilaciones) - el manifiesto del paquete UWP.

     CAMBIALO antes de empaquetar: si el Publisher no es exactamente el sujeto del certificado con
     que firmas, signtool falla.

       - Identity Name          el nombre del paquete. Pon el tuyo.
       - Identity Publisher     IDENTICO al sujeto de tu certificado, letra por letra.
       - PhoneProductId         un GUID propio: [guid]::NewGuid() en PowerShell.
       - PublisherDisplayName y DisplayName (que esta DOS veces): lo que lea la consola.

     La Version la pone esta plantilla A MANO, no el empaquetador, y tiene que subir en cada
     paquete nuevo: la consola no reemplaza un paquete por otro de la misma version.
     docs/INSTALL.es.md §5. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <Identity
    Name="CHANGE-ME-RetroRewind"
    Publisher="CN=CHANGE-ME"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <mp:PhoneIdentity PhoneProductId="00000000-0000-0000-0000-000000000001" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Mario Kart Wii Retro Rewind</DisplayName>
    <PublisherDisplayName>CHANGE-ME</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.33519.0" Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="WiiCompiled.exe"
      EntryPoint="uwp.App">
      <uap:VisualElements
        DisplayName="Mario Kart Wii Retro Rewind"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Retro Rewind sobre el port UWP de Mario Kart Wii (Wiicompiled) para Xbox Series X en modo desarrollador"
        BackgroundColor="transparent">
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png"/>
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust"/>
    <rescap:Capability Name="broadFileSystemAccess" />
    <rescap:Capability Name="expandedResources" />
    <Capability Name="internetClient" />
    <Capability Name="internetClientServer"/>
    <Capability Name="privateNetworkClientServer"/>
    <Capability Name="codeGeneration"/>
    <uap:Capability Name="removableStorage"/>
  </Capabilities>
</Package>
